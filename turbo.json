{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["AUTH_SECRET", "DB_FILE", "MESSAGE_WEBHOOK_SECRET", "NEXT_PUBLIC_APP_URL", "UPSTASH_REDIS_REST_URL", "UPSTASH_REDIS_REST_TOKEN"]
    },
    "@rentflow/web#build": {
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "build:packages": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
