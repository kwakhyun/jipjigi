# 32자 이상의 무작위 문자열을 사용하세요. 프로덕션에서는 기본값을 허용하지 않습니다.
AUTH_SECRET=replace-with-at-least-32-random-characters
# Production and Vercel: Neon Postgres connection string
DATABASE_URL=
# Local development only: PGlite data directory
DB_DIR=.data/jipjigi-pg
MESSAGE_WEBHOOK_SECRET=replace-with-webhook-secret
NEXT_PUBLIC_APP_URL=http://localhost:3108
ALLOW_DEMO_AUTH=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace 플랜에 따라 같은 REST 인증 정보가 KV 이름으로 제공될 수 있습니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=
