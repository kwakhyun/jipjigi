# 32자 이상의 무작위 문자열을 사용하세요. 프로덕션에서는 기본값을 허용하지 않습니다.
AUTH_SECRET=replace-with-at-least-32-random-characters
DB_FILE=.data/jipjigi.db
MESSAGE_WEBHOOK_SECRET=replace-with-webhook-secret
NEXT_PUBLIC_APP_URL=http://localhost:3108
ALLOW_DEMO_AUTH=true
# 두 값을 모두 설정하면 요청 제한이 다중 인스턴스 Redis 모드로 전환됩니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
