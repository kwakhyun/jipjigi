{
  "name": "rentflow",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@rentflow/web",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "bundle:check": "pnpm --filter @rentflow/web bundle:check",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm bundle:check",
    "db:reset": "pnpm --filter @rentflow/web db:reset"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
