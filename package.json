{
  "name": "jipjigi",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev --filter=@jipjigi/web",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "bundle:check": "pnpm --filter @jipjigi/web bundle:check",
    "test:e2e": "pnpm --filter @jipjigi/web test:e2e",
    "test:e2e:setup": "pnpm --filter @jipjigi/web test:e2e:setup",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm bundle:check",
    "db:reset": "pnpm --filter @jipjigi/web db:reset",
    "db:migrate": "pnpm --filter @jipjigi/web db:migrate",
    "db:setup": "pnpm --filter @jipjigi/web db:setup"
  },
  "devDependencies": {
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
